rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 누구나 글을 읽을 수 있음
    match /posts/{postId} {
      allow read: if true;
      // 허용된 관리자 계정만 작성·수정·삭제 가능
      allow write: if request.auth != null
        && request.auth.token.email == "fkdna3@gmail.com"
        && request.auth.token.email_verified == true;
    }
  }
}
