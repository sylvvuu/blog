rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 관리자: 허용된 Google 계정 (이메일 인증 완료)
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == "fkdna3@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // 글: 공개 글은 누구나 읽기, 나만보기 글은 관리자만 읽기. 작성·삭제는 관리자만
    // 로그인한 사용자는 좋아요·스크랩 카운터 숫자만 바꿀 수 있음
    match /posts/{postId} {
      allow read: if resource.data.visibility == 'public' || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'scraps', 'views'])
        && request.resource.data.get('likes', 0) >= 0
        && request.resource.data.get('scraps', 0) >= 0
        && request.resource.data.get('views', 0) >= 0
        && (isSignedIn() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']))
      );

      // 날짜별 조회수: 누구나 1씩 올릴 수 있고, 값은 음수가 될 수 없음
      match /daily/{day} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['count', 'date'])
          && request.resource.data.count is int
          && request.resource.data.count >= 0
          && request.resource.data.date is string;
      }

      // 좋아요: 사용자 본인 uid 문서로 기록 (한 사람당 1개)
      match /likes/{uid} {
        allow read: if true;
        allow create, delete: if isSignedIn() && request.auth.uid == uid;
      }

      // 댓글: 로그인 사용자만 작성, 삭제는 관리자만
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
        allow delete: if isAdmin();
      }
    }

    // 스크랩: 본인 계정 아래에만 저장 (로그인 필요)
    match /users/{uid}/scraps/{postId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // 신입 지원: 로그인한 본인 계정으로만 제출 (이름과 이메일), 읽기·삭제는 관리자만
    match /applications/{applicationId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 100
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.postId is string && request.resource.data.postId.size() <= 100;
      allow read, delete: if isAdmin();
    }

    // 사이트 설정 (날씨 위젯 기상청 인증키): 방문자가 읽고, 쓰기는 관리자만
    // 주의: 방문자 브라우저가 키를 받아야 하므로 이 키는 사실상 공개된다 (Firestore를 직접 읽으면 누구나 볼 수 있음)
    match /settings/weather {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.kmaServiceKey is string
        && request.resource.data.kmaServiceKey.size() <= 200;
    }
    // 공공취업정보 인증키 (홈 맨 아래 목록용)
    match /settings/jobs {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.serviceKey is string
        && request.resource.data.serviceKey.size() <= 200;
    }

    // 교육(국민내일배움카드 훈련과정) 서비스 인증키: 채용 키와 별도
    // 고용24 추가 API 인증키 (교육 추가 과정, 직업정보 검색)
    match /settings/work24 {
      allow read: if true;
      allow write: if isAdmin();
    }

    // AI 상담 설정 (관리자만 쓰기, 화면과 서버 함수가 함께 읽음)
    match /settings/chat {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.enabled is bool
        && request.resource.data.model in ["claude-haiku-5-5", "claude-sonnet-5-5", "claude-opus-5-5"]
        && request.resource.data.extraRules is string
        && request.resource.data.extraRules.size() <= 1000;
    }

    match /settings/education {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.serviceKey is string
        && request.resource.data.serviceKey.size() <= 200;
    }

    // 명언: 방문자가 읽고, 관리자만 추가·삭제 (수정은 막음)
    match /quotes/{quoteId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
        && request.resource.data.author is string && request.resource.data.author.size() <= 50;
      allow delete: if isAdmin();
    }

    // 문의 게시판: 로그인 사용자가 작성, 공개 글과 본인 글은 읽기 가능, 답변·상태 수정과 삭제는 관리자만
    match /inquiries/{inquiryId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
        && request.resource.data.category in ['채용', '교육', '기타']
        && request.resource.data.isPublic is bool
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 1000
        && request.resource.data.status == '대기';
      allow read: if isAdmin()
        || resource.data.get('isPublic', false) == true
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      // 관리자: 답변·상태 수정, 또는 기존 문의의 이메일 삭제와 이름 가리기 (개인정보 정리 버튼 전용)
      allow update: if isAdmin()
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply', 'repliedAt', 'status'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email']));
      allow delete: if isAdmin();
    }
  }
}
